# Runtime settings only. Keep this file root:aliyun-ecs-control 0640.
# TARGETS_FILE is the initial migration source. Web-managed credentials are encrypted.
# Web login requires TOTP_SECRET and accepts only its current six-digit code.
TOTP_SECRET=
TARGETS_FILE=/etc/aliyun-ecs-control-targets.json
MANAGED_CONFIG_PATH=/var/lib/aliyun-ecs-control/config.json
CREDENTIAL_KEY_PATH=/etc/aliyun-ecs-control.key
PASSKEY_PATH=/var/lib/aliyun-ecs-control/passkeys.json
PASSKEY_RP_ID=ali.hkz.241214.top
PASSKEY_ORIGIN=https://ali.hkz.241214.top
AUDIT_PATH=/var/lib/aliyun-ecs-control/audit.log
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787
STATE_PATH=/var/lib/aliyun-ecs-control/state.json
LOCK_DIR=/var/lib/aliyun-ecs-control/locks
SESSION_HOURS=8

# Set both to true only when a local HTTPS reverse proxy is in front.
COOKIE_SECURE=false
TRUST_PROXY=false
